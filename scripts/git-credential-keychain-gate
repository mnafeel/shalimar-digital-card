#!/bin/bash
# Require macOS Keychain unlock before any git credential use.
# Used as: git -c credential.helper=... or via scripts/git-update.sh
set -euo pipefail

KEYCHAIN="${HOME}/Library/Keychains/login.keychain-db"
if [[ ! -f "$KEYCHAIN" ]]; then
  KEYCHAIN="${HOME}/Library/Keychains/login.keychain"
fi

# Always force a Keychain password prompt before credential access.
security lock-keychain "$KEYCHAIN" 2>/dev/null || true
security unlock-keychain "$KEYCHAIN"

# After unlock, delegate to the normal macOS helper.
exec git credential-osxkeychain "$@"
